{{ 'section-service.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: 0px;
    padding-right: 0px;
    margin-top: {{ section.settings.margin_top | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      margin-top: {{ section.settings.margin_top }}px;
    }
  }
  @media screen and (min-width: 1500px){
    .section-{{ section.id }}-padding {
      padding-left: {{ section.settings.padding_left }}px;
      padding-right: {{ section.settings.padding_right }}px;
    }
  }
{%- endstyle -%}

<div class="service-block" data-section-id="{{ section.id }}" data-section-type="services-section">    
  <div class="page-inner-width gradient {% if section.settings.full_width == false %}page-width{% endif %}">
    <div class="services-block" style="background-color: {{ section.settings.background_color }};">
    {%- unless section.settings.heading == blank -%}
      <div class="title-wrapper-with-link{% if posts_displayed > 2 %} title-wrapper--self-padded-tablet-down{% else %} title-wrapper--self-padded-mobile{% endif %} title-wrapper--no-top-margin">
        <h2 class="title {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endunless -%}
    
    {% if section.blocks.size > 0 %}
    <div class="services-wrapper section-{{ section.id }}-padding">
      <div class="services stickyscroll" id="services-{{ section.id }}">
        {%- assign i = 1 -%}
        {% for block in section.blocks %} 
        <a href="{{ block.settings.button_link }}" class="service service-{{ i }} scroll-item">
          {% if block.settings.icon != blank %}
          <div class="service-icon service-icon{{ block.id }}"></div>
          {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'service-icon' }}
          {%- endif -%}
          <div class="service-description"> 
            <div class="service-title">{{ block.settings.service-title | escape }}</div>
            <div class="service-subtitle">{{ block.settings.service-subtitle }}</div>
          </div>
        </a>
        {% if block.settings.icon != blank %}
        <style>
          .service-icon{{ block.id }} {background-image: url('{{ block.settings.icon | img_url: '65x' }}');}
        </style>
        {% endif %}
        {%- assign i = i | plus:1 -%}
        {% endfor %}
      </div>
    </div>
    {% endif %}
    {% if section.blocks.size == 0 %}
    <div class="placeholder-noblocks">
      {{ 'homepage.onboarding.no_content' | t }}
    </div>
    {% endif %}      
</div>
</div>

{% schema %}
  {
	"name": "t:sections.service.name",
  	"tag": "section",
  	"class": "spaced-section section service-section",
    "max_blocks": 5,
    "settings": [
    {
      "type": "color",
      "id": "background_color",
      "default": "#FFFFFF",
      "label": "t:sections.service.settings.background_color.label"
    },
     {
      "type": "checkbox",
      "id": "full_width",
      "default": false,
      "label": "t:sections.service.settings.full_width.label"
    },
	{
      "type": "text",
      "id": "heading",
      "label": "t:sections.service.settings.heading.label"
    },
   {
    "type": "select",
    "id": "heading_size",
    "options": [
      {
        "value": "h2",
        "label": "t:sections.all.heading_size.options__1.label"
      },
      {
        "value": "h1",
        "label": "t:sections.all.heading_size.options__2.label"
      },
      {
        "value": "h0",
        "label": "t:sections.all.heading_size.options__3.label"
      }
    ],
    "default": "h2",
    "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.margin_top",
      "default": 0
    },
	{
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "t:sections.all.padding.padding_left",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "t:sections.all.padding.padding_right",
      "default": 80
    }
	],
    "blocks": [
      { 
        "type": "service_image",
        "name": "t:sections.service.blocks.name",
        "settings": [
  		  {
            "type": "image_picker",
            "id": "icon",
            "label": "t:sections.service.blocks.settings.icon.label"
          },
          {
            "type": "text",
            "id": "service-title",
            "label": "t:sections.service.blocks.settings.service-title.label",
            "default": "service title"
          },
		{
            "type": "text",
            "id": "service-subtitle",
            "label": "t:sections.service.blocks.settings.service-subtitle.label" ,
            "default": "service-subtitle"
          },
		          
		{
            "type": "url",
            "id": "button_link",
            "label": "t:sections.service.blocks.settings.button_link.label"
          }
        ]
      }
    ],
	"presets": [
      {
        "name": "t:sections.service.presets.name"
      }
    ]
  }
{% endschema %}
