{{ 'section-collection-list.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  :root {
    --grid-collection-desktop-horizontal-spacing : {{ settings.spacing_grid_horizontal | plus: 0 }}px;
  }
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
    padding-left: {{ section.settings.padding_left | times: 0.5 | round: 0 }}px;
    padding-right: {{ section.settings.padding_right | times: 0.5 | round: 0 }}px;
  }
  .collection-list.owl-carousel .collection-list__item{
    padding-inline: calc(var(--grid-mobile-horizontal-spacing) / 2 );
  }
  .collection-list-wrapper slider-component.slider-component-desktop{
    margin-inline: calc(calc(var(--grid-mobile-horizontal-spacing) / 2 ) - var(--grid-mobile-horizontal-spacing));
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  @media screen and (min-width: 990px) {
     .collection-list.owl-carousel .collection-list__item{
        padding-inline: calc(var(--grid-desktop-horizontal-spacing) / 2 );
      }
      .collection-list-wrapper slider-component.slider-component-desktop{
        margin-inline: calc(calc(var(--grid-desktop-horizontal-spacing) / 2 ) - var(--grid-desktop-horizontal-spacing));
      }
  }
  @media screen and (min-width: 1440px) {
     .collection-list.owl-carousel .collection-list__item{
        padding-inline: calc(var(--grid-collection-desktop-horizontal-spacing) / 2 );
      }
      .collection-list-wrapper slider-component.slider-component-desktop{
        margin-inline: calc(calc(var(--grid-collection-desktop-horizontal-spacing) / 2 ) - var(--grid-collection-desktop-horizontal-spacing));
      }
  }
  @media screen and (min-width: 1500px) {
    .section-{{ section.id }}-padding{
      padding-left: {{ section.settings.padding_left }}px;
      padding-right: {{ section.settings.padding_right }}px;
    }
  }
{%- endstyle -%}

{% if section.settings.bkg_image != blank %}
  <style>
    .section-collection-list {
      background: url('{{ section.settings.bkg_image | img_url: 'master' }}') no-repeat center;
      background-size: cover;
      background-color: var(--color-base-background-2);
    }
  </style>
{%- endif -%}
{%- liquid
  assign columns_mobile_int = section.settings.columns_mobile | plus: 0
  assign show_mobile_slider = false
  if section.settings.swipe_on_mobile and section.blocks.size > columns_mobile_int
    assign show_mobile_slider = true
  endif
-%}

<div class="collection-list-wrapper {% if section.settings.full-width == false %} page-width{% endif %} isolate{% if section.settings.title == blank %} no-heading{% endif %}{% if section.settings.show_view_all == false or section.blocks.size > collections.size %} no-mobile-link{% endif %}">
  <div
    class="gradient section-{{ section.id }}-padding"
    style="background-color: {{ section.settings.bkg_color }};"
  >
    {%- unless section.settings.title == blank -%}
      <div class="title-wrapper{% if show_mobile_slider %} title-wrapper--self-padded-tablet-down{% else %} title-wrapper--self-padded-mobile{% endif %} title-wrapper--no-top-margin">
        <h2
          id="SectionHeading-{{ section.id }}"
          class="title collection-list-title inline-richtext {{ section.settings.heading_size }}"
        >
          {{ section.settings.title }}
        </h2>
        {%- if section.settings.description != blank -%}
          <div class="collection__description {{ section.settings.description_style }} rte">
            {%- if section.settings.show_description -%}
              {{ section.settings.collection.description }}
            {%- else -%}
              {{ section.settings.description -}}
            {%- endif %}
          </div>
        {%- endif -%}

        {%- if section.settings.show_view_all and show_mobile_slider -%}
          <a
            href="{{ routes.collections_url }}"
            id="ViewAll-{{ section.id }}"
            class="link underlined-link large-up-hide"
            aria-labelledby="ViewAll-{{ section.id }} SectionHeading-{{ section.id }}"
          >
            {{- 'sections.collection_list.view_all' | t -}}
          </a>
        {%- endif -%}
      </div>
    {%- endunless -%}

    <slider-component class="slider-mobile-gutter{% if show_mobile_slider %} slider-component-desktop{% endif %}">
      <ul
        class="collection-list{% if show_mobile_slider %} owl-carousel {% else %} grid{% endif %} contains-card contains-card--collection{% if settings.card_style == 'standard' %} contains-card--standard{% endif %}  grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down{% if section.settings.swipe_on_mobile %} slider slider--tablet grid--peek{% endif %} collection-list--{{ section.blocks.size }}-items"
        id="Slider-{{ section.id }}"
        role="list"
      >
        {%- liquid
          assign columns = section.blocks.size
          if columns > 3
            assign columns = 3
          endif
        -%}

        {%- for block in section.blocks -%}
          {% if section.settings.product_row %}
            {% if section.settings.enable_desktop_slider %}
              {% assign remainder = forloop.index | modulo: 2 %}
              {%- if remainder == 1 -%}
                <li
                  id="Slide-{{ section.id }}-{{ forloop.index }}"
                  class="slider-{{ block.id }} collection-list__item grid__item{% if show_mobile_slider %} slider__slide{% endif %}{% if block.settings.collection.featured_image == nil %} collection-list__item--no-media{% endif %} {% if section.settings.product_row %} product_row{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  <ul>
              {%- endif -%}
              <li class="slide-item">
                {% render 'card-collection-list',
                  card_collection: block.settings.collection,
                  background_color: block.settings.background_color,
                  card_collection_icon: block.settings.icon,
                  card_collection_links: block.settings.menu,
                  media_aspect_ratio: section.settings.image_ratio,
                  columns: columns
                %}
              </li>
              {%- if remainder == 0 -%}
                </ul>
                </li>
              {%- endif -%}
            {% else %}
              <li
                id="Slide-{{ section.id }}-{{ forloop.index }}"
                class="slider-{{ block.id }} collection-list__item grid__item{% if show_mobile_slider %} slider__slide{% endif %}{% if block.settings.collection.featured_image == nil %} collection-list__item--no-media{% endif %} {% if section.settings.product_row %} product_row{% endif %}"
                {{ block.shopify_attributes }}
              >
                {% render 'card-collection-list',
                  card_collection: block.settings.collection,
                  background_color: block.settings.background_color,
                  card_collection_icon: block.settings.icon,
                  card_collection_links: block.settings.menu,
                  media_aspect_ratio: section.settings.image_ratio,
                  columns: columns
                %}
              </li>
            {% endif %}
          {% else %}
            <li
              id="Slide-{{ section.id }}-{{ forloop.index }}"
              class="slider-{{ block.id }} collection-list__item grid__item{% if show_mobile_slider %} slider__slide{% endif %}{% if block.settings.collection.featured_image == nil %} collection-list__item--no-media{% endif %} {% if section.settings.product_row %} product_row{% endif %}"
              {{ block.shopify_attributes }}
            >
              {% render 'card-collection-list',
                card_collection: block.settings.collection,
                background_color: block.settings.background_color,
                card_collection_icon: block.settings.icon,
                card_collection_links: block.settings.menu,
                media_aspect_ratio: section.settings.image_ratio,
                columns: columns
              %}
            </li>
          {% endif %}
        {%- else -%}
          {%- for i in (1..4) -%}
            <li
              {% if section.settings.enable_desktop_slider == false %}
                grid__item
              {% endif -%}
              {% if show_mobile_slider or show_desktop_slider %}
                slider__slide
              {% endif %}
            >
              {%- assign placeholder_image = 'product-apparel-' | append: forloop.rindex -%}
              {% render 'card-product', placeholder_image: placeholder_image %}
            </li>
          {%- endfor -%}
        {%- endfor -%}
      </ul>
      {% comment %}
        <div class="slider-buttons no-js-hidden">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
          >
            {% render 'icon-caret' %}
          </button>
          <div class="slider-counter caption">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
            <span class="slider-counter--total">{{ section.blocks.size }}</span>
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
          >
            {% render 'icon-caret' %}
          </button>
        </div>
      {% endcomment %}
    </slider-component>

    {%- if section.settings.show_view_all and section.blocks.size < collections.size -%}
      <div class="center collection-list-view-all{% if show_mobile_slider %} small-hide medium-hide{% endif %}">
        <a
          href="{{ routes.collections_url }}"
          class="button"
          id="ViewAllButton-{{ section.id }}"
          aria-labelledby="ViewAllButton-{{ section.id }} SectionHeading-{{ section.id }}"
        >
          {{- 'sections.collection_list.view_all' | t -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
    $(document).ready(function() {
      $('.collection-list.owl-carousel').owlCarousel({
        loop: !0,
        nav: !0,
        dots: !1,
        autoplay: !1,
        responsive:{
          0:{
            items:1
          },
          320:{
            items: {{ section.settings.columns_mobile | minus: 0 }}
          },
          380:{
            items: {{ section.settings.columns_desktop | minus: 2 }}
          },
          541:{
            items: {{ section.settings.columns_desktop | minus: 1 }}
          },
          768:{
            items: {{ section.settings.columns_desktop | minus: 1 }}
          },
          990:{
            items: {{ section.settings.columns_desktop | minus: 0 }}
          },
          1270:{
            items: {{ section.settings.columns_desktop | minus: 0 }}
          },
          1780:{
            items: {{ section.settings.columns_desktop | minus: 0 }}
          }
      }
      })

  });
</script>

{% schema %}
{
  "name": "t:sections.collection-list.name",
  "tag": "section",
  "class": "section section-collection-list",
  "max_blocks": 35,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "bkg_image",
      "label": "t:sections.collection-list.settings.bkg_image.label"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Shop By Categories",
      "label": "t:sections.collection-list.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.collection-list.settings.description.label"
    },
      {
      "type": "select",
      "id": "description_style",
      "label": "t:sections.collection-list.settings.description_style.label",
      "options": [
        {
          "value": "body",
          "label": "t:sections.collection-list.settings.description_style.options__1.label"
        },
        {
          "value": "subtitle",
          "label": "t:sections.collection-list.settings.description_style.options__2.label"
        },
        {
          "value": "uppercase",
          "label": "t:sections.collection-list.settings.description_style.options__3.label"
        }
      ],
      "default": "body"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.collection-list.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.collection-list.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.collection-list.settings.image_ratio.options__3.label"
        }
      ],
      "default": "adapt",
      "label": "t:sections.collection-list.settings.image_ratio.label",
      "info": "t:sections.collection-list.settings.image_ratio.info"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 3,
      "label": "t:sections.collection-list.settings.columns_desktop.label"
    },
    {
      "type": "color",
      "id": "bkg_color",
      "label": "t:sections.collection-list.settings.bkg_color.label"
    },
    {
      "type": "checkbox",
      "id": "full-width",
      "default": false,
      "label": "t:sections.collection-list.settings.full-width.label"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": false,
      "label": "t:sections.collection-list.settings.show_view_all.label"
    },
    {
      "type": "checkbox",
      "id": "enable_desktop_slider",
      "label": "t:sections.featured-collection.settings.enable_desktop_slider.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.collection-list.settings.header_mobile.content"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "t:sections.collection-list.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.collection-list.settings.columns_mobile.options__2.label"
        }
      ],
      "default": "1",
      "label": "t:sections.collection-list.settings.columns_mobile.label"
    },
    {
      "type": "checkbox",
      "id": "product_row",
      "label": "t:sections.collection-list.settings.product_row.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "swipe_on_mobile",
      "default": true,
      "label": "t:sections.collection-list.settings.swipe_on_mobile.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_left",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_right",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "featured_collection",
      "name": "t:sections.collection-list.blocks.featured_collection.name",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.collection-list.blocks.featured_collection.settings.collection.label"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "t:sections.collection-list.blocks.featured_collection.settings.icon.label"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:sections.collection-list.blocks.featured_collection.settings.menu.label",
          "info": "t:sections.collection-list.blocks.featured_collection.settings.menu.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection-list.presets.name",
      "blocks": [
        {
          "type": "featured_collection"
        },
        {
          "type": "featured_collection"
        },
        {
          "type": "featured_collection"
        }
      ]
    }
  ]
}
{% endschema %}
