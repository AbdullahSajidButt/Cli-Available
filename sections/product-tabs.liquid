<div class="product-tabs page-width">
  <!-- Tab Navigation -->
  <div class="tabs-nav">
    <button class="tab-link active" data-tab="description">{{ settings.tab_1_title | default: 'Description' }}</button>
    <button class="tab-link" data-tab="specifications">{{ settings.tab_2_title | default: 'Specifications' }}</button>
    <button class="tab-link" data-tab="reviews">{{ settings.tab_3_title | default: 'Reviews' }}</button>
    <button class="tab-link" data-tab="faq">{{ settings.tab_4_title | default: 'FAQs' }}</button>
  </div>

  <!-- Tab Content -->
  <div class="tab-content">
    <!-- Product Description -->
    <div class="tab-pane active" id="description">
      <div class="product-description">
        {% if product.description != blank %}
          {{ product.description }}
        {% else %}
          {{ settings.tab_1_content | default: 'This is the default product description content.' }}
        {% endif %}
      </div>
    </div>

    <!-- Product Specifications -->
    <div class="tab-pane" id="specifications">
      <div class="product-specifications">
        {% assign specifications_metafield = product.metafields[settings.specifications_metafield_namespace] %}
        
        {% if specifications_metafield %}
          <ul>
            {% for spec in specifications_metafield %}
              <li><strong>{{ spec.key }}:</strong> {{ spec.value }}</li>
            {% endfor %}
          </ul>
        {% else %}
          <p>{{ settings.tab_2_content | default: 'Default Specifications Content: Here are the product specifications.' }}</p>
        {% endif %}
      </div>
    </div>

    <!-- Product Reviews -->
    <div class="tab-pane" id="reviews">
      <div class="product-reviews">
        {% if product.metafields[settings.reviews_metafield_namespace] %}
          <ul>
            {% for review in product.metafields[settings.reviews_metafield_namespace] %}
              <li>
                <strong>{{ review.customer_name }}</strong>
                <p>{{ review.review_text }}</p>
              </li>
            {% endfor %}
          </ul>
        {% else %}
          <p>{{ settings.tab_3_content | default: 'Default Reviews Content: No reviews yet. Be the first to leave a review!' }}</p>
        {% endif %}
      </div>
    </div>

    <!-- Product FAQs -->
    <div class="tab-pane" id="faq">
      <div class="product-faqs">
        {% if product.metafields[settings.faqs_metafield_namespace] %}
          <ul>
            {% for faq in product.metafields[settings.faqs_metafield_namespace] %}
              <li>
                <strong>{{ faq.question }}</strong>
                <p>{{ faq.answer }}</p>
              </li>
            {% endfor %}
          </ul>
        {% else %}
          <p>{{ settings.tab_4_content | default: 'Default FAQ Content: Here are some frequently asked questions about the product.' }}</p>
        {% endif %}
      </div>
    </div>
  </div>
</div>

<!-- Styles -->
<style>
  .tabs-nav {
    display: flex;
    gap: 20px;
    margin-bottom: 20px;
  }
  .tab-link {
    padding: 10px 20px;
    cursor: pointer;
    border: none;
    background-color: #f1f1f1;
    border-radius: 5px;
  }
  .tab-link.active {
    background-color: #e05c0b;
    color: white;
  }
  .tab-content {
    display: flex;
    flex-direction: column;
  }
  .tab-pane {
    display: none;
  }
  .tab-pane.active {
    display: block;
  }
</style>

<!-- JavaScript for Tab Switching -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const tabLinks = document.querySelectorAll('.tab-link');
    const tabPanes = document.querySelectorAll('.tab-pane');

    tabLinks.forEach(function(tab) {
      tab.addEventListener('click', function() {
        const targetTab = tab.getAttribute('data-tab');

        tabLinks.forEach(function(link) {
          link.classList.remove('active');
        });
        tab.classList.add('active');

        tabPanes.forEach(function(pane) {
          if (pane.id === targetTab) {
            pane.classList.add('active');
          } else {
            pane.classList.remove('active');
          }
        });
      });
    });
  });
</script>





{% schema %}
{
  "name": "Product Tabs Section",
  "settings": [
    {
      "type": "header",
      "content": "Product Tabs Settings"
    },
    {
      "type": "text",
      "label": "Tab 1 - Title",
      "id": "tab_1_title",
      "default": "Description"
    },
    {
      "type": "textarea",
      "label": "Tab 1 - Content",
      "id": "tab_1_content",
      "default": "This is the default product description content."
    },
    {
      "type": "text",
      "label": "Tab 2 - Title",
      "id": "tab_2_title",
      "default": "Specifications"
    },
    {
      "type": "richtext",
      "label": "Tab 2 - Content",
      "id": "tab_2_content",
      "default": "<p>Default Specifications Content: Here are the product specifications.</p>"
    },
    {
      "type": "text",
      "label": "Tab 3 - Title",
      "id": "tab_3_title",
      "default": "Reviews"
    },
    {
      "type": "richtext",
      "label": "Tab 3 - Content",
      "id": "tab_3_content",
      "default": "<p>Default Reviews Content: No reviews yet. Be the first to leave a review!</p>"
    },
    {
      "type": "text",
      "label": "Tab 4 - Title",
      "id": "tab_4_title",
      "default": "FAQs"
    },
    {
      "type": "richtext",
      "label": "Tab 4 - Content",
      "id": "tab_4_content",
      "default": "<p>Default FAQ Content: Here are some frequently asked questions about the product.</p>"
    },
    {
      "type": "textarea",
      "label": "Specifications Metafield Namespace (e.g., 'specifications')",
      "id": "specifications_metafield_namespace",
      "default": "specifications"
    },
    {
      "type": "textarea",
      "label": "Reviews Metafield Namespace (e.g., 'reviews')",
      "id": "reviews_metafield_namespace",
      "default": "reviews"
    },
    {
      "type": "textarea",
      "label": "FAQs Metafield Namespace (e.g., 'faqs')",
      "id": "faqs_metafield_namespace",
      "default": "faqs"
    }
  ],
  "presets": [
    {
      "name": "tabs"
    }
  ]
}
{% endschema %}
